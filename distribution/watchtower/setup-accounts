#!/bin/sh
set -eu
# Use one portable state root for setup, the server and Python plugins.
WATCHTOWER_HOME=${WATCHTOWER_HOME:-"$HOME/.watchtower"}
case "$WATCHTOWER_HOME" in
    /*) export WATCHTOWER_HOME ;;
    *) printf '%s\n' 'WATCHTOWER_HOME must be an absolute path.' >&2; exit 1 ;;
esac
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
watchtower_package_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1 || ! python3 -I -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
    printf '%s\n' 'Watchtower Accounts requires Python 3.10+ on PATH.' >&2
    exit 1
fi
case "$#" in
    0) python3 -I -B "$watchtower_package_dir/accounts/setup.py" ;;
    1)
        if [ "$1" != "--link-only" ]; then
            printf '%s\n' 'Usage: setup-accounts [--link-only]' >&2
            exit 2
        fi
        python3 -I -B "$watchtower_package_dir/accounts/setup.py" --check
        ;;
    *) printf '%s\n' 'Usage: setup-accounts [--link-only]' >&2; exit 2 ;;
esac
for watchtower_plugin in accounts results teams benchmarks; do
    "$watchtower_package_dir/watchtower" plugin link "$watchtower_package_dir/$watchtower_plugin"
done
