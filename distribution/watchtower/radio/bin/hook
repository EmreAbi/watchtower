#!/bin/sh
set -eu
unset PYTHONHOME PYTHONPATH VIRTUAL_ENV
watchtower_plugin_dir=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)
if ! command -v python3 >/dev/null 2>&1 || ! python3 -I -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
    printf '%s\n' 'Watchtower requires Python 3.10+ on PATH. Install Python before opening Radio.' >&2
    exit 1
fi
exec python3 -I -B "$watchtower_plugin_dir/watchtower_radio.py" "$@"
